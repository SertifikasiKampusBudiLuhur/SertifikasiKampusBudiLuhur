# ============================================================
# .env.local — Salin file ini dan isi dengan nilai yang sesuai
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Midtrans (Sandbox) ---
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin Default (untuk seed pertama kali) ---
# Buat akun admin via Supabase dashboard, lalu update role di tabel profiles
